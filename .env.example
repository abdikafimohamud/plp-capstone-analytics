# Copy to .env and change every value. .env is git-ignored. NEVER commit real passwords.
POSTGRES_PASSWORD=change_me_postgres_superuser   # docker bootstrap only; apps never use it
ADMIN_PASSWORD=change_me_admin                   # capstone_admin: owns schema, runs migrations
INGEST_PASSWORD=change_me_ingest                 # ingest_svc    (INSERT events only)
DASHBOARD_PASSWORD=change_me_dashboard           # dashboard_svc (read-only, RLS tenant-scoped)
MONITOR_PASSWORD=change_me_monitor               # monitor_svc   (pg_monitor, for exporters)
REPLICATION_PASSWORD=change_me_replication       # replicator    (streaming replication)
GRAFANA_PASSWORD=change_me_grafana

# client defaults used by scripts/*.sh and ingest/*.py
PGHOST=localhost
PGPORT=5432
PGUSER=capstone_admin
PGDATABASE=capstone
REDIS_URL=redis://localhost:6379/0
